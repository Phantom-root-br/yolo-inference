<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.10'>
<model name='ArUco_marker'>
  <link name='ArUco_link'>
    <enable_wind>false</enable_wind>
    <visual name='ArUco_visual'>
      <geometry><plane>
        <normal>0 0 1</normal>
        <size>0.025 0.025</size>
      </plane></geometry>
      <material>
        <diffuse>0 0 0 1</diffuse>
        <specular>1 1 1 1</specular>
      </material>
    </visual>
    <visual name='ArUco_image'>
      <geometry><plane>
      <normal>0 0 1</normal>
      <size>0.25 0.25 0.01</size>
      </plane></geometry>
        <material>
        <diffuse>1 1 1 1</diffuse>
        <specular>1 1 1 1</specular>
        <pbr>
          <metal>
            <albedo_map>materials/textures/aruco_sample.png</albedo_map>
            <metalness>0</metalness>
            <roughness>1</roughness>
          </metal>
        </pbr>
      </material>
    </visual>
  </link>
  <self_collide>false</self_collide>
  <static>true</static>
</model>
</sdf>