#!/usr/bin/env bash

WORLD="eletroquad26_m1"
PX4_DIR="/root/PX4-Autopilot"
WORLD_FILE="$PX4_DIR/Tools/simulation/gz/worlds/${WORLD}.sdf"

SERVER_LOG="/tmp/eletroquad_m1_gz_server.log"
GUI_LOG="/tmp/eletroquad_m1_gz_gui.log"

echo "==========================================="
echo " ELETROQUAD M1 - GAZEBO + PX4"
echo "==========================================="

cd "$PX4_DIR" || exit 1

# Importante: plugins, modelos e recursos do PX4/Gazebo.
if [ -f "$PX4_DIR/build/px4_sitl_default/rootfs/gz_env.sh" ]; then
    source "$PX4_DIR/build/px4_sitl_default/rootfs/gz_env.sh"
fi

unset PX4_GZ_MODEL_NAME
unset PX4_GZ_MODEL
unset PX4_GZ_WORLD
unset PX4_GZ_STANDALONE

rm -f "$SERVER_LOG" "$GUI_LOG"

echo
echo "[1/4] Iniciando somente o Gazebo Server..."

gz sim -r -s "$WORLD_FILE" \
    >"$SERVER_LOG" 2>&1 &

GZ_SERVER_PID=$!

echo "Gazebo Server PID: $GZ_SERVER_PID"

echo
echo "[2/4] Aguardando serviço /world/${WORLD}/create ..."

READY=0

for i in $(seq 1 90); do
    if ! kill -0 "$GZ_SERVER_PID" 2>/dev/null; then
        echo
        echo "ERRO: Gazebo Server morreu."
        tail -80 "$SERVER_LOG"
        exec bash
    fi

    SERVICES="$(timeout 2 gz service -l 2>/dev/null || true)"

    if echo "$SERVICES" |
       grep -q "^/world/${WORLD}/create$"; then
        READY=1
        echo
        echo "Gazebo Server pronto."
        break
    fi

    printf "."
    sleep 1
done

if [ "$READY" -ne 1 ]; then
    echo
    echo "ERRO: Gazebo não ficou pronto em 90 segundos."
    tail -80 "$SERVER_LOG"
    exec bash
fi

echo
echo "[3/4] Abrindo Gazebo GUI..."

gz sim -g \
    >"$GUI_LOG" 2>&1 &

GZ_GUI_PID=$!

echo "Gazebo GUI PID: $GZ_GUI_PID"

sleep 3

echo
echo "[4/4] Iniciando PX4 e inserindo harpia_0..."
echo

PX4_GZ_STANDALONE=1 \
PX4_GZ_WORLD="$WORLD" \
make px4_sitl gz_harpia

PX4_RC=$?

echo
echo "PX4 terminou com código: $PX4_RC"
echo
echo "Gazebo Server: PID $GZ_SERVER_PID"
echo "Gazebo GUI:    PID $GZ_GUI_PID"
echo
echo "Painel preservado para diagnóstico."

exec bash
