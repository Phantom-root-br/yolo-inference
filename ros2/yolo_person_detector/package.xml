<?xml version="1.0"?>
<package format="3">
  <name>yolo_person_detector</name>
  <version>0.1.0</version>
  <description>Portable ROS 2 YOLO person detector for HARPia.</description>
  <maintainer email="noreply@example.com">HARPia Team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>yolo_person_interfaces</depend>

  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
